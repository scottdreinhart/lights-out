# Environment Configuration Template
# Copy this file to .env.local and fill in local values
# For infrastructure/deployment environment variables, use .env.*.local (platform-specific)
# These files are automatically git-ignored and never committed

# ==============================================================================
# DEVELOPMENT CACHE CONTROL
# ==============================================================================
# Anti-caching mode — used during development when you need to bypass module caching
# Activates: force dependency re-optimization, no-store headers, SW unregistration
# Use with: pnpm dev:nocache / pnpm start:nocache
# VITE_NO_CACHE=true

# ==============================================================================
# EMAIL NOTIFICATIONS (Infrastructure/CI-Related)
# ==============================================================================
# Configuration for regression test email alerts and deployment notifications
# These variables are optional and only used by CI/build infrastructure
# See docs/ENVIRONMENT.md for complete setup instructions

# Enable email notifications (true/false)
# EMAIL_ENABLED=false

# SMTP Server Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# Email Recipients for Notifications
# NOTIFICATION_EMAIL=your-email@gmail.com
# CC_EMAIL=
# SMS_EMAIL=your-phone@sms-gateway.com

# ==============================================================================
# SLACK NOTIFICATIONS (Optional, Infrastructure-Only)
# ==============================================================================
# Post deployment status to Slack channel

# SLACK_ENABLED=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# COMPLIANCE DASHBOARD (Infrastructure-Only)
# ==============================================================================
# URL for compliance dashboard used in deployment pipelines

# DASHBOARD_URL=http://localhost:3000/compliance/dashboard.html

# ==============================================================================
# NOTES ON SECURITY & GITIGNORE
# ==============================================================================
# ✅ Committed files: .env.example (this file) — template only, contains no secrets
# ⛔ Git-ignored files:
#    - .env (base environment variables)
#    - .env.local (local development overrides)
#    - .env.*.local (platform-specific: .env.android.local, .env.notifications.local, etc.)
#
# ⚠️  CRITICAL SECURITY RULES:
# 1. NEVER commit .env.local or any .env.*.local files
# 2. Use app-specific passwords (Gmail App Passwords), not account passwords
# 3. Rotate credentials quarterly
# 4. Use strong, unique passwords (16+ characters)
# 5. For CI/CD, use GitHub Secrets instead of committed files
# 6. Verify .gitignore includes .env and .env.*.local patterns
