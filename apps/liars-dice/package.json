{
  "name": "@games/liars-dice",
  "version": "1.0.0",
  "description": "Liar's Dice",
  "type": "module",
  "private": true,
  "license": "PROPRIETARY",
  "author": "Scott Reinhart",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.31.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "pnpm exec vite --host",
    "dev": "pnpm exec kill-port 5173 || true; pnpm exec vite --host",
    "build": "pnpm exec vite build",
    "web:build": "pnpm build",
    "preview": "pnpm exec vite preview",
    "build:preview": "pnpm build && pnpm preview",
    "lint": "pnpm exec eslint src/",
    "lint:fix": "pnpm exec eslint src/ --fix",
    "format": "pnpm exec prettier --write src/",
    "format:check": "pnpm exec prettier --check src/",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm format",
    "validate": "pnpm validate:gated",
    "clean": "pnpm exec rimraf dist release",
    "clean:node": "pnpm exec rimraf node_modules",
    "clean:all": "pnpm exec rimraf dist release node_modules",
    "reinstall": "pnpm clean:all && pnpm install",
    "electron:dev": "pnpm exec concurrently -k \"pnpm exec vite\" \"pnpm exec wait-on http://localhost:5173 && pnpm exec electron .\"",
    "electron:build": "pnpm exec vite build && pnpm exec electron-builder",
    "electron:build:win": "pnpm exec vite build && pnpm exec electron-builder --win",
    "electron:build:linux": "pnpm exec vite build && pnpm exec electron-builder --linux",
    "electron:build:mac": "pnpm exec vite build && pnpm exec electron-builder --mac",
    "electron:preview": "pnpm build && pnpm exec electron .",
    "cap:init:android": "pnpm exec cap add android",
    "cap:init:ios": "pnpm exec cap add ios",
    "cap:sync": "pnpm exec vite build && pnpm exec cap sync",
    "cap:build:android": "pnpm cap:sync",
    "cap:build:ios": "pnpm cap:sync",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "cap:run:android": "pnpm exec cap run android",
    "cap:run:ios": "pnpm exec cap run ios",
    "wasm:build": "pnpm exec asc assembly/index.ts --target release",
    "wasm:build:debug": "pnpm exec asc assembly/index.ts --target debug",
    "report:all": "pnpm report:lint && pnpm report:typecheck && pnpm report:test && pnpm report:coverage && pnpm report:a11y && pnpm report:lighthouse && pnpm report:security && pnpm report:build",
    "report:lint": "echo \"Lint Report:\" && pnpm lint || echo \"Lint failed\"",
    "report:typecheck": "echo \"Typecheck Report:\" && pnpm typecheck || echo \"Typecheck failed\"",
    "report:test": "echo \"Test Report:\" && pnpm test || echo \"Test failed\"",
    "report:coverage": "echo \"Coverage Report:\" && pnpm test:coverage || echo \"Coverage failed\"",
    "report:a11y": "echo \"Accessibility Report:\" && pnpm test:a11y || echo \"A11y failed\"",
    "report:lighthouse": "echo \"Lighthouse Report:\" && pnpm lighthouse || echo \"Lighthouse failed\"",
    "report:security": "echo \"Security Report:\" && pnpm audit || echo \"Security failed\"",
    "report:build": "echo \"Build Report:\" && pnpm build || echo \"Build failed\"",
    "platform:meta:build": "pnpm run build",
    "platform:twitch:build": "pnpm run build",
    "platform:crazygames:build": "pnpm run build",
    "platform:discord:build": "pnpm run build",
    "platform:telegram:build": "pnpm run build",
    "platform:steam:build": "pnpm run build",
    "test:names": "pnpm -C ../.. exec node scripts/validate-test-names-segmented.mjs --scope=apps/liars-dice/src --chunk=200",
    "validate:gated": "pnpm -C ../.. exec node scripts/validate-gated.mjs --nameScope=apps/liars-dice/src --workspaceScope=apps/liars-dice --testScope=apps/liars-dice/src --buildScope=apps/liars-dice",
    "dashboard": "pnpm -C ../.. dashboard",
    "dashboard:serve": "pnpm -C ../.. dashboard:serve",
    "format:segment": "pnpm -C ../.. exec node scripts/validate-workspace-segmented.mjs --script=format --scope=apps/liars-dice --timeoutMs=600000",
    "format:check:segment": "pnpm -C ../.. exec node scripts/validate-workspace-segmented.mjs --script=format:check --scope=apps/liars-dice --timeoutMs=600000",
    "lint:type:a11y": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=a11y --scope=all",
    "lint:type:wcag": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=wcag --scope=all",
    "lint:type:i18n": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=i18n --scope=all",
    "lint:type:security": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=security --scope=all",
    "lint:type:hooks": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=hooks --scope=all",
    "lint:type:react": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=react --scope=all",
    "lint:type:boundaries": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=boundaries --scope=all",
    "lint:type:typescript": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=typescript --scope=all",
    "lint:type:core": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=core --scope=all",
    "lint:type:all": "pnpm lint:type:a11y && pnpm lint:type:wcag && pnpm lint:type:i18n && pnpm lint:type:security && pnpm lint:type:hooks && pnpm lint:type:react && pnpm lint:type:boundaries && pnpm lint:type:typescript && pnpm lint:type:core",
    "lint:gate:a11y": "pnpm lint:phase:a11y",
    "lint:gate:wcag": "pnpm lint:phase:wcag",
    "lint:gate:i18n": "pnpm lint:phase:i18n",
    "lint:gate:compliance": "pnpm lint:phase:security && pnpm lint:phase:boundaries && pnpm lint:phase:typescript && pnpm lint:phase:core",
    "lint:gate:completeness": "pnpm lint:phase:static && pnpm validate:gated",
    "lint:phase:a11y": "pnpm lint:type:a11y",
    "lint:phase:wcag": "pnpm lint:type:wcag",
    "lint:phase:i18n": "pnpm lint:type:i18n",
    "lint:phase:security": "pnpm lint:type:security",
    "lint:phase:hooks": "pnpm lint:type:hooks",
    "lint:phase:react": "pnpm lint:type:react",
    "lint:phase:boundaries": "pnpm lint:type:boundaries",
    "lint:phase:typescript": "pnpm lint:type:typescript",
    "lint:phase:core": "pnpm lint:type:core",
    "lint:phase:static": "pnpm lint:phase:a11y && pnpm lint:phase:wcag && pnpm lint:phase:i18n && pnpm lint:phase:security && pnpm lint:phase:hooks && pnpm lint:phase:react && pnpm lint:phase:boundaries && pnpm lint:phase:typescript && pnpm lint:phase:core"
  },
  "dependencies": {
    "@games/app-hook-utils": "workspace:*",
    "@games/diagnostics-utils": "workspace:*",
    "@games/assets-shared": "workspace:*",
    "@games/common": "workspace:*",
    "@games/domain-shared": "workspace:*",
    "@games/shared-api-client": "workspace:*",
    "@games/shared-config": "workspace:*",
    "@games/shared-sanitizers": "workspace:*",
    "@games/shared-validators": "workspace:*",
    "@games/sound-context": "workspace:*",
    "@games/storage-utils": "workspace:*",
    "@games/theme-context": "workspace:*",
    "@games/ui-dice-system": "workspace:*",
    "@games/ui-utils": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-react": "^6.0.1",
    "assemblyscript": "0.28.12",
    "concurrently": "9.2.1",
    "electron": "41.1.1",
    "electron-builder": "26.8.1",
    "eslint": "10.0.3",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.16",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vite": "^8.0.8",
    "vitest": "4.0.18",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.scottreinhart.liarsdice",
    "productName": "Liars Dice"
  }
}
