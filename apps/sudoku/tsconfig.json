{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@games/common": [
        "../../packages/common/src"
      ],
      "@games/domain-shared": [
        "../../packages/domain-shared/src"
      ],
      "@games/sound-context": [
        "../../packages/sound-context/src"
      ],
      "@games/theme-context": [
        "../../packages/theme-context/src"
      ]
      "@games/diagnostics-utils": [
        "../../packages/diagnostics-utils/src"
      ],
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
