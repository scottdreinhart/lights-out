{
  "name": "@games/blackjack",
  "version": "1.0.0",
  "description": "Blackjack - Classic Card Game",
  "type": "module",
  "private": true,
  "license": "PROPRIETARY",
  "author": "Scott Reinhart",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.31.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "pnpm exec vite --host",
    "dev": "pnpm exec kill-port 5173 || true; pnpm exec vite --host",
    "build": "pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "build:preview": "pnpm build && pnpm preview",
    "lint": "pnpm exec eslint src/",
    "lint:fix": "pnpm exec eslint src/ --fix",
    "format": "pnpm exec prettier --write src/",
    "format:check": "pnpm exec prettier --check src/",
    "typecheck": "pnpm exec tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm format",
    "validate": "pnpm validate:gated",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "test:coverage": "pnpm exec vitest --coverage",
    "clean": "pnpm exec rimraf dist release",
    "clean:node": "pnpm exec rimraf node_modules",
    "clean:all": "pnpm exec rimraf dist release node_modules",
    "lint:type:a11y": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=a11y --scope=all",
    "lint:type:wcag": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=wcag --scope=all",
    "lint:type:i18n": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=i18n --scope=all",
    "lint:type:security": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=security --scope=all",
    "lint:type:hooks": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=hooks --scope=all",
    "lint:type:react": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=react --scope=all",
    "lint:type:boundaries": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=boundaries --scope=all",
    "lint:type:typescript": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=typescript --scope=all",
    "lint:type:core": "pnpm -C ../.. exec node scripts/lint-segmented.mjs --segment=core --scope=all",
    "lint:type:all": "pnpm lint:type:a11y && pnpm lint:type:wcag && pnpm lint:type:i18n && pnpm lint:type:security && pnpm lint:type:hooks && pnpm lint:type:react && pnpm lint:type:boundaries && pnpm lint:type:typescript && pnpm lint:type:core",
    "lint:gate:a11y": "pnpm lint:phase:a11y",
    "lint:gate:wcag": "pnpm lint:phase:wcag",
    "lint:gate:i18n": "pnpm lint:phase:i18n",
    "lint:gate:compliance": "pnpm lint:phase:security && pnpm lint:phase:boundaries && pnpm lint:phase:typescript && pnpm lint:phase:core",
    "lint:gate:completeness": "pnpm lint:phase:static && pnpm validate:gated",
    "test:names": "pnpm -C ../.. exec node scripts/validate-test-names-segmented.mjs --scope=apps/blackjack/src --chunk=200",
    "validate:gated": "pnpm -C ../.. exec node scripts/validate-gated.mjs --nameScope=apps/blackjack/src --workspaceScope=apps/blackjack --testScope=apps/blackjack/src --buildScope=apps/blackjack",
    "dashboard": "pnpm -C ../.. dashboard",
    "dashboard:serve": "pnpm -C ../.. dashboard:serve",
    "lint:phase:a11y": "pnpm lint:type:a11y",
    "lint:phase:wcag": "pnpm lint:type:wcag",
    "lint:phase:i18n": "pnpm lint:type:i18n",
    "lint:phase:security": "pnpm lint:type:security",
    "lint:phase:hooks": "pnpm lint:type:hooks",
    "lint:phase:react": "pnpm lint:type:react",
    "lint:phase:boundaries": "pnpm lint:type:boundaries",
    "lint:phase:typescript": "pnpm lint:type:typescript",
    "lint:phase:core": "pnpm lint:type:core",
    "lint:phase:static": "pnpm lint:phase:a11y && pnpm lint:phase:wcag && pnpm lint:phase:i18n && pnpm lint:phase:security && pnpm lint:phase:hooks && pnpm lint:phase:react && pnpm lint:phase:boundaries && pnpm lint:phase:typescript && pnpm lint:phase:core"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@games/domain-shared": "workspace:*",
    "@games/app-hook-utils": "workspace:*",
    "@games/assets-shared": "workspace:*",
    "@games/banking": "workspace:*",
    "@games/common": "workspace:*",
    "@games/storage-utils": "workspace:*",
    "@games/theme-context": "workspace:*",
    "@games/sound-context": "workspace:*",
    "@games/ui-utils": "workspace:*",
    "@games/shared-validators": "workspace:*",
    "@games/shared-sanitizers": "workspace:*",
    "@games/shared-config": "workspace:*",
    "@games/shared-api-client": "workspace:*",
    "@games/audio-engine": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "10.0.3",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "5.9.3",
    "vite": "^8.0.3",
    "vitest": "4.0.18"
  }
}
