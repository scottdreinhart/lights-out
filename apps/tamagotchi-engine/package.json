{
  "name": "@games/tamagotchi-engine",
  "version": "1.0.0",
  "description": "Tamagotchi Engine",
  "type": "module",
  "private": true,
  "license": "PROPRIETARY",
  "author": "Scott Reinhart",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.31.0"
  },
  "scripts": {
    "start": "pnpm exec vite --host",
    "dev": "pnpm exec kill-port 5173 || true; pnpm exec vite --host",
    "build": "pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "build:preview": "pnpm build && pnpm preview",
    "wasm:build": "pnpm exec node scripts/build-wasm.js",
    "wasm:build:debug": "pnpm exec node scripts/build-wasm.js --debug",
    "lint": "pnpm exec eslint src/",
    "lint:fix": "pnpm exec eslint src/ --fix",
    "format": "pnpm exec prettier --write src/",
    "format:check": "pnpm exec prettier --check src/",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm format",
    "clean": "pnpm exec rimraf dist release",
    "clean:node": "pnpm exec rimraf node_modules",
    "clean:all": "pnpm exec rimraf dist release node_modules",
    "reinstall": "pnpm clean:all && pnpm install",
    "test:names": "pnpm -C ../.. exec node scripts/validate-test-names-segmented.mjs --scope=apps/tamagotchi-engine/src --chunk=200",
    "validate:gated": "pnpm -C ../.. exec node scripts/validate-gated.mjs --nameScope=apps/tamagotchi-engine/src --workspaceScope=apps/tamagotchi-engine --testScope=apps/tamagotchi-engine/src --buildScope=apps/tamagotchi-engine",
    "validate": "pnpm validate:gated",
    "dashboard": "pnpm -C ../.. dashboard",
    "dashboard:serve": "pnpm -C ../.. dashboard:serve",
    "format:segment": "pnpm -C ../.. exec node scripts/validate-workspace-segmented.mjs --script=format --scope=apps/tamagotchi-engine --timeoutMs=600000",
    "format:check:segment": "pnpm -C ../.. exec node scripts/validate-workspace-segmented.mjs --script=format:check --scope=apps/tamagotchi-engine --timeoutMs=600000"
  },
  "dependencies": {
    "@games/common": "workspace:*",
    "@games/assets-shared": "workspace:*",
    "@games/audio-engine": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "10.0.3",
    "eslint-plugin-boundaries": "6.0.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.16",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vite": "^8.0.8",
    "vitest": "4.0.18"
  }
}
