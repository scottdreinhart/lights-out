    "rollup-plugin-visualizer": "5.14.0",
    "standard-version": "^9.5.0",
    "todo-cli": "^1.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "^8.0.8",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "4.0.18",
    "wait-on": "9.0.4"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.17.23",
      "tmp": "0.2.4",
      "three": ">=0.125.0",
      "micromatch": ">=4.0.8"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.scottreinhart.lightsout",
    "productName": "Lights Out",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "commitizen": {
    "path": "cz-git"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged; pnpm lint:gate:quick"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "*.{json,md,js}": [
      "prettier --write"
    ]
  }
}
