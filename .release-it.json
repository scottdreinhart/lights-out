{
  "git": {
    "changelog": "./CHANGELOG.md",
    "commit": true,
    "commitArgs": "--no-verify",
    "commitMessage": "🎉 chore(release): ${version}",
    "committer": {
      "name": "Release Bot",
      "email": "release@game-platform.local"
    },
    "requireBranch": [
      "main",
      "master"
    ],
    "requireCleanWorkingDir": true,
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "tagArgs": "--no-verify",
    "push": true,
    "pushArgs": "--no-verify",
    "pushTags": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "${changelog}"
  },
  "hooks": {
    "before:init": [
      "pnpm run validate"
    ],
    "after:bump": [
      "pnpm run format"
    ],
    "after:release": [
      "echo 'Released v${version}'"
    ]
  },
  "changelog": {
    "compact": false,
    "sections": [
      {
