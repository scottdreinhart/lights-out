{
  "metadata": {
    "version": "1.0.0",
    "description": "Evidence-backed approval gates derived from ingested platform documentation.",
    "authority": ".github/instructions/15-app-store-compliance.instructions.md (Sections 10-11)"
  },
  "automatedGateCitations": {
    "status-complete": {
      "sources": ["compliance/matrix.json"],
      "rationale": "Deployment readiness status is derived from matrix cell completion."
    },
    "app-exists": {
      "sources": ["compliance/app-status.json"],
      "rationale": "App registry source of truth for audited applications."
    },
    "rules-verified": {
      "sources": ["compliance/sources.json"],
      "rationale": "Game rule verification is tracked in canonical sources."
    },
    "platform-adapter": {
      "sources": ["scripts/config/platform-requirements.json"],
      "rationale": "Platform adapter requirement coverage is evaluated from platform requirement contracts."
    },
    "performance-compliance": {
      "sources": [
        "AGENTS.md § 25",
        ".github/instructions/20-css-performance-rendering-optimization.instructions.md"
      ],
      "rationale": "Performance gate follows repository web vitals and rendering governance."
    },
    "ui-compliance": {
      "sources": [
        "AGENTS.md § 12",
        "AGENTS.md § 13",
        "AGENTS.md § 23"
      ],
      "rationale": "UI compliance gate follows responsive, menu architecture, and accessibility governance."
    },
    "blockers-free": {
      "sources": ["compliance/blockers.json"],
      "rationale": "Critical blocker state is sourced from blocker registry."
    },
    "requirements-coverage": {
      "sources": ["scripts/config/platform-requirements.json", "compliance/platform-gap-analysis.json"],
      "rationale": "Platform requirement checks and missing requirement counts are generated from these files."
    }
  },
  "platforms": {
    "web": {
      "displayName": "Web",
      "sources": [
        "https://developer.mozilla.org/en-US/docs/Web/Performance",
        "https://www.w3.org/WAI/WCAG21/quickref/"
      ],
      "manualGates": []
    },
    "electron": {
      "displayName": "Electron",
      "sources": [
        "https://www.electronjs.org/docs/latest/tutorial/security",
        "https://www.electron.build/"
      ],
      "manualGates": []
    },
    "ios": {
      "displayName": "iOS",
      "sources": [
        "https://developer.apple.com/app-store/review/guidelines/"
      ],
      "manualGates": []
    },
    "android": {
      "displayName": "Android",
      "sources": [
        "https://support.google.com/googleplay/android-developer/answer/9859348"
      ],
      "manualGates": []
    },
    "meta": {
      "displayName": "Meta Instant Games",
      "sources": [
        "https://developers.facebook.com/docs/games/build/instant-games/quality-guidelines",
