{
  "metadata": {
    "version": "1.0.0",
    "description": "Canonical platform inspection requirements used for compliance matrix generation.",
    "notes": [
      "Platform key 'twitch' maps to Twitch Extensions.",
      "Requirements are evaluated per app from package scripts, metadata, and file structure."
    ]
  },
  "platforms": {
    "web": {
      "displayName": "Web",
      "requirements": [
        {
          "id": "web-build-script",
          "label": "Build script present",
          "type": "scriptExists",
          "value": "build"
        },
        {
          "id": "web-dev-script",
          "label": "Dev script present",
          "type": "scriptExists",
          "value": "dev"
        },
        {
          "id": "web-index-html",
          "label": "index.html present",
          "type": "fileExists",
          "value": "index.html"
        },
        {
          "id": "web-entrypoint",
          "label": "App entrypoint present",
          "type": "oneOfFiles",
          "values": ["src/index.tsx", "src/main.tsx"]
        },
        {
          "id": "web-vite-config",
          "label": "Vite config present",
          "type": "oneOfFiles",
          "values": ["vite.config.ts", "vite.config.js", "vite.config.mjs", "vite.config.cjs"]
        },
        {
          "id": "web-keyboard-wasd-arrows",
          "label": "Keyboard support includes WASD + Arrow keys",
          "type": "sourcePatternAll",
          "values": ["KeyW|KeyA|KeyS|KeyD|\\bWASD\\b", "ArrowUp|ArrowDown|ArrowLeft|ArrowRight"]
        }
      ]
    },
