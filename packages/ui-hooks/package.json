{
  "name": "@games/ui-hooks",
  "version": "1.0.0",
  "description": "Consolidated UI/presentation hooks for game apps (useTheme, useSoundEffects, useStats, useResponsiveState)",
  "type": "module",
  "private": true,
  "license": "PROPRIETARY",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./factories": {
      "types": "./dist/factories/index.d.ts",
      "default": "./dist/factories/index.js"
    },
    "./utilities": {
      "types": "./dist/utilities/index.d.ts",
      "default": "./dist/utilities/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format": "prettier --write src/",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm format",
    "clean": "rimraf dist",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "react": "19.2.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {}
}
